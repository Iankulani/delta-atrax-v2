# ============================================================================
# DELTA-ATRAX-V2 - Environment Configuration
# ============================================================================

# Application Settings
DELTA_ATRAX_HOME=/app
DELTA_ATRAX_CONFIG=/app/.delta_atrax_v2
DELTA_ATRAX_LOG_LEVEL=INFO
DELTA_ATRAX_SECRET_KEY=change_me_in_production

# Web Dashboard
DELTA_ATRAX_WEB_PORT=5000
DELTA_ATRAX_WEB_HOST=0.0.0.0
DELTA_ATRAX_REQUIRE_AUTH=false

# Database
DELTA_ATRAX_DB_PATH=/app/.delta_atrax_v2/delta_atrax_v2.db

# Discord Bot
DISCORD_TOKEN=
DISCORD_PREFIX=!
DISCORD_CHANNEL_ID=

# Telegram Bot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PREFIX=/

# Slack Bot
SLACK_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL_ID=
SLACK_PREFIX=!

# Signal Bot
SIGNAL_PHONE_NUMBER=
SIGNAL_GROUP_ID=

# Email/SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=delta_redis_2024

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=delta
POSTGRES_PASSWORD=delta_postgres_2024
POSTGRES_DB=delta_atrax

# Security
DELTA_ATRAX_AUTO_BLOCK=false
DELTA_ATRAX_BLOCK_THRESHOLD=5

# SaaS Settings
SAAS_ENABLED=true
SAAS_TRIAL_DAYS=14
